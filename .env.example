# Copy to .env and fill in. .env is gitignored; this file is not.
# Testnets only — no mainnet keys here, ever (CLAUDE.md "Rules").
#
# From M2 there are two .env files, one per machine. The gateway's (on the
# laptop) needs the chain section and the gateway/merchant keys; the device's
# (on the Pi) needs only the "device, on the Pi" section at the bottom. The Pi
# has no RPC URL and no gateway key, and that is the point.

# --- chain (gateway) ------------------------------------------------------
RPC_URL=http://localhost:8545
CHAIN_ID=31337
PAYMENT_CHANNEL_ADDRESS=
# The channel opened for this device, from scripts/m2_setup.py. Not read by the
# gateway — the contract holds the authoritative channel state — but kept here
# so the value the Pi was given is written down next to the deploy it belongs to.
CHANNEL_ADDRESS=

# --- signers (anvil accounts 1, 2, 3) ------------------------------------
# Device: signs the voucher. From M2 the real key lives on the Pi, generated
# there by device/keygen.py; only DEVICE_ADDRESS matters to the gateway, and
# scripts/m2_setup.py fills it in. DEVICE_PRIVATE_KEY stays for the M1
# single-machine control run (scripts/e2e_m1.py) and is not the Pi's key.
DEVICE_ADDRESS=
DEVICE_PRIVATE_KEY=

# Funder: escrows the channel deposit at open(). The vehicle owner's wallet —
# the party that owns the money, as distinct from the onboard unit that signs
# for it. Falls back to DEVICE_PRIVATE_KEY when unset. Never the Pi's key: the
# Pi holds no ETH and sends no transactions.
FUNDER_PRIVATE_KEY=

# Gateway: co-signs and pays the gas.
GATEWAY_ADDRESS=
GATEWAY_PRIVATE_KEY=

# Merchant: the charging station operator, third signer and payee.
MERCHANT_ADDRESS=
MERCHANT_PRIVATE_KEY=

# --- gateway behaviour ---------------------------------------------------
# 1 = actually broadcast settle(). 0 = verify and build calldata only.
GATEWAY_SUBMIT=1
CONFIRMATIONS=1
# 0.0.0.0 from M2 on: 127.0.0.1 is reachable from the laptop only, and the Pi
# will just time out. The port also has to be open in the Windows firewall.
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# --- device, on the Pi (device/run_tick.py) ------------------------------
# This block is the Pi's whole .env. Nothing above it belongs on the device
# except MERCHANT_PRIVATE_KEY, which stands in for the co-located charging
# station operator until merchant/signer.py becomes its own process.
#
# CHANNEL_ADDRESS, VERIFYING_CONTRACT and CHAIN_ID are printed by
# scripts/m2_setup.py. VERIFYING_CONTRACT must equal the gateway's
# PAYMENT_CHANNEL_ADDRESS: it sits inside the EIP-712 domain, so a mismatch
# produces signatures that verify nowhere.
VERIFYING_CONTRACT=
GATEWAY_URL=http://192.168.0.10:8000

# The encrypted keystore device/keygen.py wrote, on the Pi. device/keystore/ is
# gitignored. Set these instead of DEVICE_PRIVATE_KEY — agent.load_account()
# prefers the keystore when both are present.
DEVICE_KEYSTORE=
DEVICE_KEYSTORE_PASSWORD=

# Optional: voucher pricing and expiry. Defaults live in device/agent.py.
PRICE_WEI_PER_KWH=
VOUCHER_DEADLINE_SECONDS=

# --- retired keys ---------------------------------------------------------
# A key that has been exposed (printed to a terminal, pasted into a log) is
# rotated, not reused. Keep the old one here rather than deleting it: it may
# still hold settled value, and it records which key countersigned which
# voucher. Never referenced by a running component.
RETIRED_MERCHANT_ADDRESS_BURNED=
RETIRED_MERCHANT_PRIVATE_KEY_BURNED=

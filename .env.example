# Copy to .env and fill in. .env is gitignored; this file is not.
# Testnets only — no mainnet keys here, ever (CLAUDE.md "Rules").

# --- chain ---------------------------------------------------------------
RPC_URL=http://localhost:8545
CHAIN_ID=31337
PAYMENT_CHANNEL_ADDRESS=

# --- signers (anvil accounts 1, 2, 3) ------------------------------------
# Device: signs the voucher. On the Pi (M2) this becomes DEVICE_KEYSTORE and
# the raw key below goes away entirely.
DEVICE_ADDRESS=
DEVICE_PRIVATE_KEY=

# Gateway: co-signs and pays the gas.
GATEWAY_ADDRESS=
GATEWAY_PRIVATE_KEY=

# Merchant: the charging station operator, third signer and payee.
MERCHANT_ADDRESS=
MERCHANT_PRIVATE_KEY=

# --- gateway behaviour ---------------------------------------------------
# 1 = actually broadcast settle(). 0 = verify and build calldata only.
GATEWAY_SUBMIT=1
CONFIRMATIONS=1
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
